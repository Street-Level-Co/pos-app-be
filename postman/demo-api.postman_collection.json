              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json().data;",
                  "    if (Array.isArray(data) && data.length > 0 && data[0].id) {",
                  "        pm.collectionVariables.set('countryId', data[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/country",
              "host": ["{{baseUrl}}"],
              "path": ["api", "country"]
            }
          },
          "response": []
